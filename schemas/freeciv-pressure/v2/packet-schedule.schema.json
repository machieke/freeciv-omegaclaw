{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omegaclaw.local/schemas/freeciv-pressure/v2/packet-schedule.schema.json",
  "title": "PF-PLN scalar-v2 whole-packet schedule",
  "type": "object",
  "required": [
    "scheduler_identity",
    "budgets",
    "reservations",
    "committed_operation_ids",
    "stranded_quanta",
    "integrality_gap",
    "relaxed_value",
    "committed_value",
    "accounting",
    "conserved"
  ],
  "properties": {
    "scheduler_identity": {"const": "pf-pln-packet-scheduler/2.0"},
    "budgets": {"type": "array"},
    "reservations": {"type": "array"},
    "committed_operation_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "stranded_quanta": {"type": "array"},
    "integrality_gap": {"type": "number", "minimum": 0},
    "relaxed_value": {"type": "number", "minimum": 0},
    "committed_value": {"type": "number", "minimum": 0},
    "accounting": {"type": "object"},
    "conserved": {"const": true}
  }
}
