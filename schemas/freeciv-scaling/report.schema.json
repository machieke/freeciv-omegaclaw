{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takopi.local/schemas/freeciv-scaling/report.schema.json",
  "title": "FreeCiv scalability aggregate report",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "captured", "claim_boundary", "combined", "engine_shadow", "gates", "phase_reports", "schema_version", "surfaces"],
  "properties": {
    "artifact_type": {"const": "freeciv-scalability-report"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "captured": {"type": "object"},
    "combined": {"type": "object"},
    "engine_shadow": {"type": "object"},
    "gates": {"type": "object"},
    "phase_reports": {"type": "object"},
    "schema_version": {"const": "1.0"},
    "surfaces": {"type": "object"}
  }
}
