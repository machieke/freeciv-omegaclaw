{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takopi.local/schemas/freeciv-scaling/frozen-manifest.schema.json",
  "title": "Frozen FreeCiv scalability held-out selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "base_preregistration_hash", "environment_hash",
    "freeze_hash", "frozen", "payload_count", "payloads",
    "schema_version", "source_identity"
  ],
  "properties": {
    "artifact_type": {"const": "freeciv-scalability-frozen-preregistration"},
    "base_preregistration_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "freeze_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frozen": {"const": true},
    "payload_count": {"type": "integer", "minimum": 1},
    "payloads": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "schema_version": {"const": "1.0"},
    "source_identity": {"type": "string", "minLength": 1}
  }
}
