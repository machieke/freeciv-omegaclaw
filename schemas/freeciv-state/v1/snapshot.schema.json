{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omegaclaw.local/schemas/freeciv-state/v1/snapshot.schema.json",
  "title": "PLN-FreeCiv authoritative proxy state",
  "type": "object",
  "additionalProperties": true,
  "required": ["turn", "phase", "player_id", "authoritative", "techs", "units", "cities", "map", "legal_actions"],
  "properties": {
    "turn": {"type": "integer", "minimum": 0},
    "phase": {"type": "string"},
    "player_id": {"type": "integer", "minimum": 0},
    "authoritative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_seq", "player", "research", "ruleset", "known_hut_tiles"],
      "properties": {
        "source_seq": {"type": "integer", "minimum": 0},
        "known_hut_tiles": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        },
        "player": {
          "type": "object",
          "required": ["is_alive", "gold", "gold_per_turn", "tax", "science", "luxury"],
          "properties": {
            "is_alive": {"type": "boolean"},
            "gold": {"type": "integer"},
            "gold_per_turn": {"type": ["integer", "null"]},
            "city_gold_surplus_per_turn": {"type": ["integer", "null"]},
            "gold_upkeep_style": {
              "type": ["string", "null"], "enum": ["City", "Mixed", "Nation", null]
            },
            "unit_gold_upkeep": {"type": ["integer", "null"], "minimum": 0},
            "gold_upkeep_reserve": {"type": ["integer", "null"], "minimum": 0},
            "tax": {"type": "integer", "minimum": 0, "maximum": 100},
            "science": {"type": "integer", "minimum": 0, "maximum": 100},
            "luxury": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        "research": {
          "type": "object",
          "required": ["bulbs_researched", "beakers_per_turn"],
          "properties": {
            "bulbs_researched": {"type": "integer"},
            "beakers_per_turn": {"type": "integer"},
            "researching": {"type": ["integer", "null"]},
            "researching_cost": {"type": ["integer", "null"]}
          }
        },
        "ruleset": {
          "type": "object",
          "required": ["ready"],
          "properties": {"ready": {"const": true}}
        }
      }
    },
    "techs": {"type": "object"},
    "units": {"oneOf": [{"type": "object"}, {"type": "array"}]},
    "cities": {"oneOf": [{"type": "object"}, {"type": "array"}]},
    "map": {
      "type": "object",
      "required": ["width", "height", "tiles"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "tiles": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "integer", "minimum": 0},
              {
                "type": "object",
                "required": ["index"],
                "properties": {
                  "index": {"type": "integer", "minimum": 0},
                  "x": {"type": "integer", "minimum": 0},
                  "y": {"type": "integer", "minimum": 0},
                  "terrain": {},
                  "known": {},
                  "owner": {}
                }
              }
            ]
          }
        },
        "visibility": {
          "oneOf": [
            {"type": "object", "additionalProperties": {"type": "boolean"}},
            {"type": "array", "items": {"type": "boolean"}}
          ]
        }
      }
    },
    "visible_tiles": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "integer", "minimum": 0},
          {
            "type": "object",
            "anyOf": [
              {"required": ["index"]},
              {"required": ["tile"]}
            ],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "tile": {"type": "integer", "minimum": 0}
            }
          }
        ]
      }
    },
    "legal_actions": {"oneOf": [{"type": "object"}, {"type": "array"}]}
  }
}
