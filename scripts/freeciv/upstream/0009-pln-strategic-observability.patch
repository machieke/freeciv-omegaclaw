+        def built_improvements(city):
+            bitvector = city.get('improvements')
+            if not isinstance(bitvector, list):
+                return []
+            rows = []
+            for raw_id, improvement in self.improvements.items():
+                try:
+                    improvement_id = int(raw_id)
