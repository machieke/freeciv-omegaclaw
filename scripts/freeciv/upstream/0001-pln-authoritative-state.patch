+def build_state_cache_key(player_id: int, query_format: str, turn: int,
+                          source_seq: int, game_id: str = None) -> str:
+    """Return a cache identity for one authoritative state revision.
+
+    A turn alone is not a state revision: founding a city, moving a unit, or
+    changing production can all update authoritative state without advancing
+    the turn. ``source_seq`` is incremented for every packet received from the
+    server, so a cache hit is only possible while the packet-backed state is
+    unchanged.
+    """
+    # Player identifiers, turns, and packet sequence counters are local to one
+    # civserver process. Parallel games therefore collide on all four legacy
+    # fields. Scope the shared process cache by game before using those fields.
+    game_scope = (hashlib.sha256(str(game_id).encode("utf-8")).hexdigest()[:16]
+                  if game_id is not None else "legacy")
+    return "state_game_{}_player_{}_{}_turn_{}_seq_{}".format(
+        game_scope, int(player_id), str(query_format), int(turn), int(source_seq))
+
