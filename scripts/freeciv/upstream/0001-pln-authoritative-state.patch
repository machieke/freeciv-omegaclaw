+"""Contract tests for the packet-backed PLN authoritative state format."""
+
+import asyncio
+import json
+import logging
+from unittest.mock import Mock
+
+from activity_constants import ACTIVITY_NAMES
+from civcom import ACTION_TRANSPORT_EMBARK, CivCom, get_activity_name
+from llm_handler import LLMWSHandler, logger as proxy_logger
+from message_validator import MessageValidator, ValidationError
+from packet_constants import DS_ALLIANCE, DS_WAR, PACKET_UNIT_SHORT_INFO
+from security import InputSanitizer
+from state_extractor import StateExtractor, StateFormat
+
+
+def test_proxy_logging_defaults_to_non_debug_release_level():
+    assert proxy_logger.level == logging.INFO
+
+
+def make_civcom():
+    civcom = object.__new__(CivCom)
+    civcom.source_seq = 44
+    civcom.rulesets_ready = True
+    civcom.player_packets = {
+        0: {"is_alive": True, "gold": 31, "tax": 30, "science": 60, "luxury": 10,
+            "tech_upkeep": 1}
+    }
+    civcom.research_info = {
+        0: {"researching": 2, "researching_cost": 50,
+            "bulbs_researched": 17, "total_bulbs_prod": 9,
+            "inventions": ["2", "1"]}
+    }
+    civcom.techs = {2: {"name": "Writing"}}
+    civcom.unit_types = {1: {"name": "Warriors"}}
+    civcom.improvements = {1: {"name": "Barracks"}}
+    civcom.player_cities = {
+        4: {"id": 4, "owner": 0, "prod": [5, 4, 3, 2, 0, 10],
+            "surplus": [2, 3, 3, 4, 0, 10]},
+        5: {"id": 5, "owner": 1, "prod": [5, 4, 3, 99, 0, 99],
+            "surplus": [2, 3, 3, 99, 0, 99]},
+    }
+    civcom._normalize_to_dict = CivCom._normalize_to_dict.__get__(civcom)
+    civcom.build_llm_optimized_state = lambda player_id: {
+        "format": "llm_optimized", "player_id": player_id,
+        "cities": civcom.player_cities,
+        "units": {7: {"id": 7, "owner": player_id}},
+        "legal_actions": [{"type": "end_turn", "is_valid": True}],
+    }
+    civcom.get_full_state = lambda player_id: civcom.build_llm_optimized_state(player_id)
+    civcom.game_turn = 12
+    return civcom
+
+
+def test_authoritative_state_uses_player_packet_and_owned_city_outputs():
+    state = CivCom.build_pln_authoritative_state(make_civcom(), 0)
+    assert state["format"] == "pln_authoritative"
+    assert state["authoritative"]["source_seq"] == 44
+    assert state["authoritative"]["player"]["is_alive"] is True
+    assert state["authoritative"]["player"]["gold"] == 31
+    assert state["authoritative"]["player"]["gold_per_turn"] == 4
+    assert state["authoritative"]["research"]["beakers_per_turn"] == 9
+    assert state["authoritative"]["research"]["researching_name"] == "Writing"
+    assert state["authoritative"]["ruleset"]["ready"] is True
+    assert state["authoritative"]["known_hut_tiles"] == []
+
+
+def test_eliminated_player_status_suppresses_stale_assets_and_actions():
+    civcom = make_civcom()
+    civcom.player_packets[0]["is_alive"] = False
+
+    state = CivCom.build_pln_authoritative_state(civcom, 0)
+
+    assert state["authoritative"]["player"]["is_alive"] is False
+    assert state["authoritative"]["player"]["gold_per_turn"] == 0
+    assert state["cities"] == {
+        5: civcom.player_cities[5],
+    }
+    assert state["units"] == {}
+    assert state["legal_actions"] == []
+    assert CivCom.player_is_eliminated(civcom, 0)
+
+
+def test_missing_or_true_player_status_is_not_elimination():
+    civcom = make_civcom()
+    assert not CivCom.player_is_eliminated(civcom, 0)
+    civcom.player_packets[0].pop("is_alive")
+    assert not CivCom.player_is_eliminated(civcom, 0)
+
+
+def test_authoritative_state_exposes_only_exact_packet_known_hut_extras():
+    civcom = make_civcom()
+    civcom.tiles = {
+        56: {"index": 56, "extras": [1 << 5]},
+        57: {"index": 57, "extras": [1 << 6]},
+    }
+    civcom.extras = {
+        5: {"id": 5, "causes": [1 << 6]},
+        6: {"id": 6, "causes": [0]},
+    }
+
+    state = CivCom.build_pln_authoritative_state(civcom, 0)
+
+    assert state["authoritative"]["known_hut_tiles"] == [56]
+    assert CivCom.tile_has_extra_cause(civcom, 56, 6)
+    assert not CivCom.tile_has_extra_cause(civcom, 57, 6)
+
+
+def test_city_founding_rejects_packet_known_no_cities_terrain():
+    civcom = make_civcom()
+    civcom.map_info = {"width": 10, "height": 10}
+    civcom.citymindist = 3
+    civcom.player_cities = {}
+    civcom.tiles = {56: {"terrain": 4, "owner": 255}}
+    civcom.terrains = {
+        4: {"tclass": 0, "flags": [1 << 1]},
+        5: {"tclass": 0, "flags": [0]},
+    }
+
+    assert CivCom.can_city_be_founded_at(civcom, 56, 0) == (
+        False, "Terrain has NoCities flag")
+    civcom.tiles[56]["terrain"] = 5
+    assert CivCom.can_city_be_founded_at(civcom, 56, 0) == (True, None)
+
+
+def test_city_founding_rejects_packet_known_foreign_claim():
+    civcom = make_civcom()
+    civcom.map_info = {"width": 10, "height": 10}
+    civcom.citymindist = 3
+    civcom.player_cities = {}
+    civcom.tiles = {56: {"terrain": 5, "owner": 1}}
+    civcom.terrains = {5: {"tclass": 0, "flags": [0]}}
+
+    assert CivCom.can_city_be_founded_at(civcom, 56, 0) == (
+        False, "Tile is claimed by foreign player 1")
+    civcom.tiles[56]["owner"] = 0
+    assert CivCom.can_city_be_founded_at(civcom, 56, 0) == (True, None)
+    civcom.tiles[56]["owner"] = 255
+    assert CivCom.can_city_be_founded_at(civcom, 56, 0) == (True, None)
+
+
+def test_known_technology_names_use_exact_invention_array_indices():
+    civcom = make_civcom()
+    civcom.techs = {
+        0: {"name": "Alphabet"},
+        1: {"name": "Bronze Working"},
+        2: {"name": "Writing"},
+    }
+    civcom.research_info[0]["inventions"] = ["2", "1", "2"]
+
+    assert CivCom._build_techs_dict(civcom) == {
+        "player0": ["Alphabet", "Writing"]}
+
+
+def test_missing_output_vector_is_unavailable_not_zero():
+    civcom = make_civcom()
+    civcom.player_cities[4].pop("prod")
+    state = CivCom.build_pln_authoritative_state(civcom, 0)
+    assert state["authoritative"]["research"]["beakers_per_turn"] is None
+
+
+def test_authoritative_format_passes_protocol_security_and_extractor_layers():
+    message = MessageValidator().validate_message(json.dumps({
+        "type": "state_query", "format": "pln_authoritative",
+        "after_source_seq": 44, "wait_timeout_ms": 5000,
+        "accept_unchanged": True, "settle_quiet_ms": 50}))
+    assert message["format"] == "pln_authoritative"
+    assert message["after_source_seq"] == 44
+    assert message["wait_timeout_ms"] == 5000
+    assert message["accept_unchanged"] is True
+    assert message["settle_quiet_ms"] == 50
+    sanitized = InputSanitizer.sanitize_state_query_params({
+        "format": "pln_authoritative",
+        "after_source_seq": 44,
+        "wait_timeout_ms": 5000,
+        "accept_unchanged": True,
+        "settle_quiet_ms": 50,
+    })
+    assert sanitized == {
+        "format": "pln_authoritative",
+        "after_source_seq": 44,
+        "wait_timeout_ms": 5000,
+        "accept_unchanged": True,
+        "settle_quiet_ms": 50,
+    }
+    state = StateExtractor(civcom=make_civcom()).extract_state(
+        "contract-game", 0, StateFormat.PLN_AUTHORITATIVE)
+    assert state["format"] == "pln_authoritative"
+
+
+def make_handler():
+    handler = Mock()
+    handler.agent_id = "contract-agent"
+    handler.player_id = 0
+    handler.game_id = "contract-game"
+    handler.civcom = Mock()
+    handler.state_extractor = Mock()
+    handler._get_fallback_state = Mock(return_value={"turn": 0})
+    handler._build_fallback_state_from_full = Mock(
+        return_value={"format": "fallback"})
+    handler._build_optimized_state = (
+        LLMWSHandler._build_optimized_state.__get__(handler, LLMWSHandler))
+    return handler
+
+
+def test_authoritative_handler_skips_unused_generic_state_build():
+    handler = make_handler()
+    handler.state_extractor.extract_state.return_value = {
+        "format": "pln_authoritative",
+        "authoritative": {"source_seq": 44},
+    }
+
+    state = handler._build_optimized_state("pln_authoritative", False)
+
+    handler.civcom.get_full_state.assert_not_called()
+    handler._get_fallback_state.assert_not_called()
+    assert state["format"] == "pln_authoritative"
+    assert state["player_id"] == 0
+
+
+def test_authoritative_handler_loads_generic_state_for_error_fallback():
+    handler = make_handler()
+    full_state = {"turn": 12, "units": {}, "cities": {}}
+    handler.civcom.get_full_state.return_value = full_state
+    handler.state_extractor.extract_state.side_effect = RuntimeError(
+        "authoritative projection unavailable")
+
+    state = handler._build_optimized_state("pln_authoritative", False)
+
+    handler.civcom.get_full_state.assert_called_once_with(0)
+    handler._build_fallback_state_from_full.assert_called_once_with(full_state)
+    assert state["format"] == "fallback"
+    assert state["player_id"] == 0
+
+
+def test_extractor_cache_does_not_mask_same_turn_packet_revision():
+    civcom = make_civcom()
+    extractor = StateExtractor(civcom=civcom)
+
+    first = extractor.extract_state(
+        "contract-game", 0, StateFormat.PLN_AUTHORITATIVE)
+    civcom.source_seq += 1
+    civcom.techs[3] = {"name": "Industrialization"}
+    civcom.research_info[0].update({
+        "researching": 3,
+        "researching_cost": 80,
+    })
+    second = extractor.extract_state(
+        "contract-game", 0, StateFormat.PLN_AUTHORITATIVE)
+
+    assert first["authoritative"]["source_seq"] == 44
+    assert first["authoritative"]["research"]["researching_name"] == "Writing"
+    assert second["authoritative"]["source_seq"] == 45
+    assert second["authoritative"]["research"]["researching_name"] == "Industrialization"
+
+
+def test_authoritative_extractor_skips_ineligible_four_kib_cache():
+    civcom = make_civcom()
+    cache = Mock()
+    cache.get.return_value = None
+    extractor = StateExtractor(civcom=civcom, cache=cache)
+
+    state = extractor.extract_state(
+        "contract-game", 0, StateFormat.PLN_AUTHORITATIVE)
+
+    assert state["format"] == "pln_authoritative"
+    cache.get.assert_not_called()
+    cache.set.assert_not_called()
+
+
+def test_source_sequence_wait_wakes_only_after_a_new_revision():
+    async def scenario():
+        civcom = object.__new__(CivCom)
+        civcom.source_seq = 7
+        civcom.source_update_event = asyncio.Event()
+        civcom.source_update_loop = None
+
+        async def update():
+            await asyncio.sleep(0.01)
+            civcom.source_seq = 8
+            civcom._signal_source_update()
+
+        task = asyncio.create_task(update())
+        advanced = await civcom.wait_for_source_seq(7, 0.2)
+        bound_to_waiting_loop = (
+            civcom.source_update_loop is asyncio.get_running_loop())
+        await task
+        timed_out = await civcom.wait_for_source_seq(8, 0.01)
+        return advanced, timed_out, bound_to_waiting_loop
+
+    assert asyncio.run(scenario()) == (True, False, True)
+
+
+def test_settled_source_state_rebuilds_after_revision_during_quiet_interval():
+    async def scenario():
+        civcom = object.__new__(CivCom)
