+def test_llm_handler_renews_active_sessions_before_expiry(monkeypatch):
+    """Long model turns must not expire an otherwise active proxy session."""
+    session = SimpleNamespace(expires_at=time.time() + 10)
+
+    class FakeSessionManager:
+        session_timeout = 100
+
+        def __init__(self):
+            self.extensions = []
+
+        def validate_session(self, session_id):
+            assert session_id == "session-1"
+            return session
+
+        def extend_session(self, session_id, extension):
+            self.extensions.append((session_id, extension))
+            return True
+
+    manager = FakeSessionManager()
+    monkeypatch.setattr(llm_handler, "session_manager", manager)
+    handler = object.__new__(llm_handler.LLMWSHandler)
+    handler.session_id = "session-1"
+    handler.session_info = None
+    handler.agent_id = "release-agent"
+
+    assert handler._validate_session()
+    assert handler.session_info is session
+    assert len(manager.extensions) == 1
+    assert manager.extensions[0][0] == "session-1"
