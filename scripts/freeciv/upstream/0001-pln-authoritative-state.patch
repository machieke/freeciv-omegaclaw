+def test_release_rate_budget_supports_authoritative_state_polling():
+    """The limiter value is a per-window count despite its legacy name."""
+    config_path = Path(__file__).resolve().parents[1] / "llm_config.json"
+    config = json.loads(config_path.read_text(encoding="utf-8"))
+    rate_limit = config["validation"]["rate_limit"]
+
+    effective_requests_per_second = (
+        rate_limit["requests_per_second"] / rate_limit["window_seconds"])
+    assert effective_requests_per_second >= 10
+    assert rate_limit["burst_capacity"] >= rate_limit["requests_per_second"]
+
+
+def test_release_success_logging_is_opt_in():
+    config_path = Path(__file__).resolve().parents[1] / "llm_config.json"
+    logging_config = json.loads(
+        config_path.read_text(encoding="utf-8"))["logging"]
+
+    assert logging_config == {
+        "level": "INFO",
+        "log_actions": False,
+        "log_state_queries": True,
+        "log_performance": False,
+    }
+
+
+@pytest.mark.asyncio
+async def test_release_settings_are_safe_complete_and_ruleset_first():
+    civcom = Mock()
+    session = GameSession("release", 6001)
+    config = {
+        "ruleset": "civ2civ3", "minplayers": 1, "aifill": 2,
+        "mapseed": 104729, "gameseed": 104729, "sciencebox": 1,
+        "techlevel": 100, "startpos": "all", "startcity": True,
+        "fogofwar": False, "max_turns": 20,
+        "ai_skill_level": "experimental",
+    }
+    assert await session.configure_game_settings(config, civcom)
+    commands = [json.loads(call.args[0])["message"]
+                for call in civcom.queue_to_civserver.call_args_list]
+    assert commands == [
+        "/rulesetdir civ2civ3", "/set minplayers 1", "/set aifill 2",
+        "/set mapseed 104729", "/set gameseed 104729", "/set sciencebox 1",
+        "/set techlevel 100", "/set fogofwar disabled", "/set startcity enabled",
+        "/set startpos all",
+        "/set endturn 20", "/experimental",
+    ]
+    civcom.send_packets_to_civserver.assert_called_once_with()
+    assert session.game_config == config
+    assert session.min_players == 1
