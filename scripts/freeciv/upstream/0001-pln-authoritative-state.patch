+import unittest
+
+from civlauncher import restart_delay
+
+
+class RestartDelayTest(unittest.TestCase):
+
+    def test_clean_exit_uses_prompt_restart_delay(self):
+        self.assertEqual(restart_delay(0), 0.1)
+
+    def test_error_and_exception_paths_retain_backoff(self):
+        self.assertEqual(restart_delay(1), 5)
+        self.assertEqual(restart_delay(-15), 5)
+        self.assertEqual(restart_delay(None), 5)
+
+
+if __name__ == "__main__":
+    unittest.main()
