+            remaining = session.expires_at - time.time()
+            renewal_threshold = max(1, session_manager.session_timeout // 2)
+            if remaining <= renewal_threshold:
+                extension = max(
+                    1, int(session_manager.session_timeout - max(0, remaining)))
+                if not session_manager.extend_session(self.session_id, extension):
+                    logger.error(
+                        f"Failed to renew active session {self.session_id} "
+                        f"for {self.agent_id}")
+                    return False
             self.session_info = session
             return True
 
