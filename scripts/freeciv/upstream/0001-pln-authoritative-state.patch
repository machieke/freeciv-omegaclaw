index 44cefa7..53f4558 100644
--- a/freeciv-proxy/bitvector.py
+++ b/freeciv-proxy/bitvector.py
@@ -13,7 +13,26 @@ References:
     - freeciv/freeciv/common/fc_types.h (size constants: MAX_NUM_UNITS=250, MAX_NUM_BUILDINGS=200)
 """
 
-from typing import List, Set, Optional
+from typing import Any, List, Set, Optional
+
+
+def bitvector_is_set(raw: Any, bit_number: int) -> bool:
+    """Read one bit from any packet bitvector representation used here."""
+    if bit_number < 0:
+        return False
+    if isinstance(raw, BitVector):
+        return raw.is_set(bit_number)
+    if isinstance(raw, int):
+        return bool(raw & (1 << bit_number))
+    if not isinstance(raw, (list, tuple)):
+        return False
+    byte_index = bit_number // 8
+    if byte_index >= len(raw):
+        return False
+    try:
+        return bool(int(raw[byte_index]) & (1 << (bit_number % 8)))
+    except (TypeError, ValueError):
+        return False
 
 
