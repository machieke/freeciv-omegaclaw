@@ -0,0 +1,200 @@
+"""Release-harness game settings are validated and ordered before start."""
+
+import ast
+import json
+import time
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from game_session_manager import GameSession
+from action_validator import LLMActionValidator
+import llm_handler
+import packet_converter
+from security import InputSanitizer, SecurityError
+
+
+@pytest.mark.asyncio
+async def test_release_settings_are_safe_complete_and_ruleset_first():
+    civcom = Mock()
+    session = GameSession("release", 6001)
+    config = {
+        "ruleset": "civ2civ3", "minplayers": 1, "aifill": 2,
+        "mapseed": 104729, "gameseed": 104729, "sciencebox": 1,
+        "techlevel": 100, "startpos": "all", "startcity": True,
+        "fogofwar": False, "max_turns": 20,
+        "ai_skill_level": "experimental",
+    }
+    assert await session.configure_game_settings(config, civcom)
+    commands = [json.loads(call.args[0])["message"]
+                for call in civcom.queue_to_civserver.call_args_list]
+    assert commands == [
+        "/rulesetdir civ2civ3", "/set minplayers 1", "/set aifill 2",
+        "/set mapseed 104729", "/set gameseed 104729", "/set sciencebox 1",
+        "/set techlevel 100", "/set fogofwar disabled", "/set startcity enabled",
+        "/set startpos all",
+        "/set endturn 20", "/experimental",
+    ]
+    civcom.send_packets_to_civserver.assert_called_once_with()
+    assert session.game_config == config
+    assert session.min_players == 1
+
+
+@pytest.mark.asyncio
+async def test_release_settings_reject_command_injection_and_bad_ranges():
+    civcom = Mock()
+    session = GameSession("release", 6001)
+    await session.configure_game_settings({
+        "ruleset": "classic\n/quit", "minplayers": 0, "aifill": 31,
+        "mapseed": -1, "gameseed": True, "sciencebox": 0,
+        "techlevel": 101, "startpos": "all\n/quit", "fogofwar": "FALSE",
+        "ai_skill_level": "hard\n/quit",
+    }, civcom)
+    civcom.queue_to_civserver.assert_not_called()
+
+
+def test_llm_handler_honors_validated_explicit_release_port():
+    """The validated ``port`` handshake field must not be silently ignored."""
+    source = (Path(__file__).resolve().parents[1] / "llm_handler.py").read_text(
+        encoding="utf-8")
+    ast.parse(source)
+    assert "requested_port = msg_data.get('port')" in source
+    assert "6001 <= requested_port <= 6009" in source
+    assert "civserver_port = requested_port" in source
+
+
+def test_llm_handler_renews_active_sessions_before_expiry(monkeypatch):
+    """Long model turns must not expire an otherwise active proxy session."""
+    session = SimpleNamespace(expires_at=time.time() + 10)
+
+    class FakeSessionManager:
+        session_timeout = 100
+
+        def __init__(self):
+            self.extensions = []
+
+        def validate_session(self, session_id):
+            assert session_id == "session-1"
+            return session
+
+        def extend_session(self, session_id, extension):
+            self.extensions.append((session_id, extension))
+            return True
+
+    manager = FakeSessionManager()
+    monkeypatch.setattr(llm_handler, "session_manager", manager)
+    handler = object.__new__(llm_handler.LLMWSHandler)
+    handler.session_id = "session-1"
+    handler.session_info = None
+    handler.agent_id = "release-agent"
+
+    assert handler._validate_session()
+    assert handler.session_info is session
+    assert len(manager.extensions) == 1
+    assert manager.extensions[0][0] == "session-1"
+    assert 89 <= manager.extensions[0][1] <= 91
+
+
+def test_research_validation_defers_runtime_ruleset_names_to_mapper():
+    validator = LLMActionValidator()
+    for name in ("communism", "genetic engineering", "advanced flight"):
+        result = validator.validate_action(
+            {"type": "tech_research", "tech_name": name, "player_id": 0}, 0, {})
+        assert result.is_valid
+    invalid = validator.validate_action(
+        {"type": "tech_research", "tech_name": "bad; /quit", "player_id": 0}, 0, {})
+    assert not invalid.is_valid and invalid.error_code == "E041"
+
+
+def test_city_production_preserves_and_sanitizes_exact_ruleset_ids():
+    handler = object.__new__(llm_handler.LLMWSHandler)
+    normalized = handler._normalize_agent_action({
+        "action_type": "city_production", "city_id": 10,
+        "target": {"production_type": "Granary"},
+        "production_kind": 3, "production_value": 14,
+    })
+    assert normalized == {
+        "type": "city_production", "city_id": 10,
+        "production_type": "granary", "production_kind": 3,
+        "production_value": 14,
+    }
+    assert InputSanitizer.sanitize_action_data(normalized) == normalized
+    with pytest.raises(SecurityError):
+        InputSanitizer.sanitize_action_data(dict(normalized, production_kind=7))
+
+
+def test_city_production_numeric_ids_are_cross_checked_before_transport(monkeypatch):
+    class Mapper:
+        def __init__(self, _civcom):
+            pass
+
+        def map_production_to_kind_value(self, _name):
+            return 3, 14
+
+    monkeypatch.setattr(packet_converter, "RulesetMapper", Mapper)
+    handler = object.__new__(llm_handler.LLMWSHandler)
+    handler.civcom = object()
+    packet = handler._convert_action_to_packet({
+        "type": "city_production", "city_id": 10,
+        "production_type": "granary", "production_kind": 3,
+        "production_value": 14,
+    })
+    assert packet["production_kind"] == 3
+    assert packet["production_value"] == 14
+    with pytest.raises(ValueError, match="do not match"):
+        handler._convert_action_to_packet({
+            "type": "city_production", "city_id": 10,
+            "production_type": "granary", "production_kind": 3,
+            "production_value": 17,
+        })
+
+
+def test_join_city_preserves_and_requires_exact_owned_colocated_target():
+    handler = object.__new__(llm_handler.LLMWSHandler)
+    normalized = handler._normalize_agent_action({
+        "action_type": "unit_join_city", "actor_id": 7,
+        "target": {"city": "Rome", "city_id": 10},
+    })
+    assert normalized == {
+        "type": "unit_join_city", "unit_id": 7, "city_id": 10}
+    assert InputSanitizer.sanitize_action_data(normalized) == normalized
+
+    game_state = {
+        "units": {"7": {"id": 7, "owner": 0, "tile": 55,
+                         "moves_left": 3}},
+        "cities": {"10": {"id": 10, "owner": 0, "tile": 55}},
+    }
+    validator = LLMActionValidator()
+    assert validator.validate_action(
+        dict(normalized, player_id=0), 0, game_state).is_valid
+    missing = validator.validate_action(
+        {"type": "unit_join_city", "unit_id": 7, "player_id": 0},
+        0, game_state)
+    assert not missing.is_valid and missing.error_code == "E025"
+    displaced = validator.validate_action(
+        dict(normalized, player_id=0), 0,
+        dict(game_state, cities={"10": dict(game_state["cities"]["10"],
+                                             tile=56)}))
+    assert not displaced.is_valid and displaced.error_code == "E028"
+
+    handler.civcom = object()
+    packet = handler._convert_action_to_packet(normalized)
+    assert packet["actor_id"] == 7
+    assert packet["target_id"] == 10
+    with pytest.raises(ValueError, match="requires a non-negative city_id"):
+        handler._convert_action_to_packet({
+            "type": "unit_join_city", "unit_id": 7})
+
+
+def test_join_city_action_response_keeps_city_id():
+    handler = object.__new__(llm_handler.LLMWSHandler)
+    rows = handler._format_unit_actions_for_response(7, {"actions": [{
+        "action": "join_city", "params": {"city": "Rome", "city_id": 10},
+        "is_valid": True, "action_id": 28,
+    }]})
+    assert rows == [{
+        "action_type": "unit_join_city", "actor_id": 7, "is_valid": True,
+        "action_id": 28, "target": {"city": "Rome", "city_id": 10},
+    }]
