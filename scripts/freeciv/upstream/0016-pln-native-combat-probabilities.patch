+def _combat_probability_packet(actor_id=7, target_id=8, target_tile=12):
+    probabilities = [
+        {"min": 253, "max": 0}
+        for _ in range(54)
+    ]
+    probabilities[45] = {"min": 119, "max": 121}
+    return {
+        "actor_unit_id": actor_id,
+        "target_unit_id": target_id,
+        "target_city_id": 0,
+        "target_tile_id": target_tile,
