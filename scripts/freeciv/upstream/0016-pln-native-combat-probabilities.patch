+    @staticmethod
+    def _pln_combat_unit_revision(
+            unit, require_actor_state=False):
+        """Return only packet fields that can invalidate native combat odds."""
+        if not isinstance(unit, dict):
+            return None
+        fields = (
+            'id', 'owner', 'type_id', 'tile', 'moves_left', 'hp', 'veteran',
+            'activity', 'transported', 'transported_by')
+        revision = {
+            field: unit.get(field)
+            for field in fields
+        }
+        required = (
+            'id', 'owner', 'type_id', 'tile', 'hp',
+            'veteran', 'activity', 'transported')
+        if require_actor_state:
+            required += ('moves_left',)
+        return revision if all(
+            revision.get(field) is not None
+            for field in required) else None
+
+    def _pln_visible_stack_revision(self, target_tile):
+        """Describe exactly the visible unit stack used by the server query."""
+        rows = []
+        for unit in self._normalize_to_dict(
+                getattr(self, 'player_units', {})).values():
+            if unit.get('tile') != target_tile:
+                continue
+            revision = self._pln_combat_unit_revision(
+                unit)
+            # Foreign PACKET_UNIT_SHORT_INFO intentionally omits movement
+            # state, which cannot affect defender identity. Preserve that
+            # omission as None. Any missing combat-relevant target field makes
+            # the complete stack unrevisionable and the query must abstain.
+            if revision is None:
+                return None
+            rows.append(revision)
+        return sorted(rows, key=lambda row: row['id'])
+
+    def _valid_pln_combat_probability(self, result, player_id):
+        """Reject cross-player, stale-actor, and stale-target probability rows."""
+        if not isinstance(result, dict) or result.get('player_id') != player_id:
+            return False
+        units = self._normalize_to_dict(getattr(self, 'player_units', {}))
+        actor_id = result.get('actor_unit_id')
+        actor = units.get(str(actor_id))
+        if actor is None:
+            actor = units.get(actor_id)
+        return bool(
+            isinstance(actor, dict)
+            and actor.get('owner') == player_id
+            and result.get('turn') == self.game_turn
+            and result.get('actor_revision')
+                == self._pln_combat_unit_revision(
+                    actor, require_actor_state=True)
+            and result.get('target_stack_revision')
+                == self._pln_visible_stack_revision(
+                    result.get('target_tile_id')))
+
+    @staticmethod
+    def _pln_combat_probability_rows(probabilities):
+        """Normalize bounded combat action intervals without interpreting them."""
+        if not isinstance(probabilities, list):
+            return None
+        # These IDs are stable protocol action IDs in the pinned server:
+        # capture-units, attack, suicide-attack, conquer-city, bombard.
+        action_names = {
+            24: 'capture_units',
+            45: 'attack',
+            46: 'suicide_attack',
+            49: 'conquer_city',
+            53: 'bombard',
+        }
+        rows = []
+        for action_id, action_name in sorted(action_names.items()):
+            if action_id >= len(probabilities):
+                return None
+            probability = probabilities[action_id]
+            if not isinstance(probability, dict):
+                return None
+            minimum = probability.get('min')
+            maximum = probability.get('max')
+            if any(
+                isinstance(value, bool) or not isinstance(value, int)
+                for value in (minimum, maximum)
+            ):
+                return None
+            if 0 <= minimum <= maximum <= 200:
+                status = 'bounded'
+            elif (minimum, maximum) == (253, 0):
+                status = 'not_applicable'
+            elif (minimum, maximum) == (254, 0):
+                status = 'not_implemented'
+            else:
+                return None
+            rows.append({
+                'action_id': action_id,
+                'action_name': action_name,
+                'minimum': minimum,
+                'maximum': maximum,
+                'status': status,
+            })
+        return rows
+
+    def _record_pln_combat_probability(self, packet):
+        """Store one response only when it matches an explicit PLN request."""
+        actor_id = packet.get('actor_unit_id')
+        target_tile = packet.get('target_tile_id')
+        if any(
+            isinstance(value, bool) or not isinstance(value, int)
+            for value in (actor_id, target_tile)
+        ):
+            return
+        key = self._pln_combat_probability_key(actor_id, target_tile)
+        pending = getattr(
+            self, 'pln_combat_probability_requests', {}).pop(key, None)
+        if not isinstance(pending, dict):
+            return
+        rows = self._pln_combat_probability_rows(
+            packet.get('action_probabilities'))
+        if rows is None or packet.get('request_kind') != 1:
+            return
+        selected_target_id = packet.get('target_unit_id')
+        target_city_id = packet.get('target_city_id')
+        target_extra_id = packet.get('target_extra_id')
+        if any(
+            isinstance(value, bool) or not isinstance(value, int)
+            for value in (
+                selected_target_id, target_city_id, target_extra_id)
+        ):
+            return
+        if (
+            selected_target_id != 0
+            and selected_target_id not in {
+                row.get('id')
+                for row in pending[
+                    'target_stack_revision']
+            }
+        ):
+            return
+        result = {
+            'schema_version': '1.0',
+            'authority': 'freeciv-server-action-probability',
+            'player_id': pending['player_id'],
+            'actor_unit_id': actor_id,
+            'actor_revision': pending['actor_revision'],
+            'target_tile_id': target_tile,
+            'target_unit_id': selected_target_id,
+            'target_city_id': target_city_id,
+            'target_extra_id': target_extra_id,
+            'target_stack_revision': pending['target_stack_revision'],
+            'request_kind': 'background_refresh',
+            'action_probabilities': rows,
+            'turn': pending['turn'],
+            'request_source_seq': pending['source_seq'],
+            'response_source_seq': self.source_seq,
+        }
+        cache = getattr(self, 'pln_combat_probabilities', None)
+        if not isinstance(cache, dict):
+            cache = {}
+            self.pln_combat_probabilities = cache
+        cache[key] = result
+        if len(cache) > 256:
+            oldest = min(
+                cache, key=lambda cache_key: (
+                    cache[cache_key].get('response_source_seq', -1),
+                    cache_key))
+            del cache[oldest]
+        event = getattr(self, 'pln_combat_probability_event', None)
+        if event is not None:
+            loop = getattr(self, 'source_update_loop', None)
+            if loop is not None and loop.is_running():
+                loop.call_soon_threadsafe(event.set)
+            else:
+                event.set()
+
+    def _current_pln_combat_probabilities(self, player_id):
+        rows = [
