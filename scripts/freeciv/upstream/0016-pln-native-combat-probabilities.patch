+                row['actor_unit_id'], row['target_tile_id']))
+
+    async def prepare_pln_combat_probabilities(
+            self, player_id, maximum_queries=32, timeout_seconds=0.25):
+        """Request bounded native odds for adjacent visible combat targets."""
+        if (
+            isinstance(maximum_queries, bool)
+            or not isinstance(maximum_queries, int)
+            or maximum_queries < 1 or maximum_queries > 32
+        ):
+            raise ValueError("maximum_queries must be in 1..32")
+        width = getattr(self, 'map_info', {}).get('width')
+        if not isinstance(width, int) or isinstance(width, bool) or width < 1:
+            return 0
+        visible_foreign_tiles = {
+            unit.get('tile')
+            for unit in self._normalize_to_dict(
+                getattr(self, 'player_units', {})).values()
+            if (
+                unit.get('owner') != player_id
+                and isinstance(unit.get('tile'), int)
+                and not isinstance(unit.get('tile'), bool)
+            )
+        }
+        candidates = set()
+        combat_names = {
+            'attack', 'suicide_attack', 'capture', 'conquer_city', 'bombard'}
+        for action in self._get_unit_actions(player_id):
+            if (
+                not isinstance(action, dict)
+                or action.get('is_valid') is not True
+                or action.get('action') not in combat_names
+            ):
+                continue
+            actor_id = action.get('unit_id')
+            target = (
+                action.get('params', {}).get('target')
+                if isinstance(action.get('params'), dict) else None)
+            if (
+                not isinstance(actor_id, int)
+                or isinstance(actor_id, bool)
+                or not isinstance(target, dict)
+                or not isinstance(target.get('x'), int)
+                or isinstance(target.get('x'), bool)
+                or not isinstance(target.get('y'), int)
+                or isinstance(target.get('y'), bool)
+            ):
+                continue
+            target_tile = target['x'] + target['y'] * width
+            if target_tile in visible_foreign_tiles:
+                candidates.add((actor_id, target_tile))
+        units = self._normalize_to_dict(getattr(self, 'player_units', {}))
+        cache = getattr(self, 'pln_combat_probabilities', {})
+        requests = []
+        for actor_id, target_tile in sorted(candidates):
+            actor = units.get(str(actor_id))
+            if actor is None:
+                actor = units.get(actor_id)
+            actor_revision = self._pln_combat_unit_revision(
+                actor, require_actor_state=True)
+            target_stack_revision = (
+                self._pln_visible_stack_revision(
+                    target_tile))
+            if (
+                actor_revision is None
+                or target_stack_revision is None
+                or actor.get('owner') != player_id
+                or actor.get('moves_left', 0) <= 0
+            ):
+                continue
+            key = self._pln_combat_probability_key(actor_id, target_tile)
+            if self._valid_pln_combat_probability(cache.get(key), player_id):
+                continue
+            requests.append((key, actor_id, target_tile, {
+                'player_id': player_id,
+                'actor_revision': actor_revision,
+                'target_stack_revision':
+                    target_stack_revision,
+                'turn': self.game_turn,
+                'source_seq': self.source_seq,
+            }))
+            if len(requests) >= maximum_queries:
+                break
+        if not requests:
+            return 0
+
+        event = getattr(self, 'pln_combat_probability_event', None)
+        if event is None:
+            event = asyncio.Event()
+            self.pln_combat_probability_event = event
+        pending_cache = getattr(
+            self, 'pln_combat_probability_requests', None)
+        if not isinstance(pending_cache, dict):
+            pending_cache = {}
+            self.pln_combat_probability_requests = pending_cache
+        self.source_update_loop = asyncio.get_running_loop()
+        event.clear()
+        for key, actor_id, target_tile, revision in requests:
+            pending_cache[key] = revision
+            self.queue_to_civserver(json.dumps({
+                'pid': PACKET_UNIT_GET_ACTIONS,
+                'actor_unit_id': actor_id,
+                'target_unit_id': 0,
+                'target_tile_id': target_tile,
+                'target_extra_id': -1,
+                'request_kind': 1,
+            }))
+        self.send_packets_to_civserver()
+
+        loop = asyncio.get_running_loop()
+        deadline = loop.time() + timeout_seconds
+        pending = {key for key, _, _, _ in requests}
+        while pending:
+            pending = {
+                key for key in pending
+                if key in pending_cache
+            }
+            if not pending:
+                break
+            remaining = deadline - loop.time()
+            if remaining <= 0:
+                break
+            event.clear()
+            pending = {
+                key for key in pending
+                if key in pending_cache
+            }
+            if not pending:
+                break
+            try:
+                await asyncio.wait_for(event.wait(), timeout=remaining)
+            except asyncio.TimeoutError:
+                break
+        for key in pending:
+            pending_cache.pop(key, None)
+        return len(requests) - len(pending)
+
