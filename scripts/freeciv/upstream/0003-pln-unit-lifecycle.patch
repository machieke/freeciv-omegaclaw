+    def _append_unit_lifecycle(self, row):
+        """Append one bounded packet-backed unit transition."""
+        journal = getattr(self, 'unit_lifecycle', None)
+        if not isinstance(journal, list):
+            journal = []
+            self.unit_lifecycle = journal
+        journal.append(dict(row))
+        if len(journal) > 512:
+            del journal[:-512]
+
+    def _record_unit_combat(self, packet):
+        """Remember exact zero-HP combat outcomes until UNIT_REMOVE arrives."""
+        recent = getattr(self, '_recent_unit_combat', None)
+        if not isinstance(recent, dict):
+            recent = {}
+            self._recent_unit_combat = recent
+        combat = {
+            'source_seq': self.source_seq,
+            'turn': self.game_turn,
+            'attacker_unit_id': packet.get('attacker_unit_id'),
+            'defender_unit_id': packet.get('defender_unit_id'),
+            'attacker_hp': packet.get('attacker_hp'),
+            'defender_hp': packet.get('defender_hp'),
+        }
+        for role in ('attacker', 'defender'):
+            unit_id = combat.get(role + '_unit_id')
+            hp = combat.get(role + '_hp')
+            if unit_id is not None and hp is not None and hp <= 0:
+                recent[unit_id] = dict(
+                    combat, cause='combat_{}_lost'.format(role))
+        minimum_seq = self.source_seq - 256
+        self._recent_unit_combat = {
+            unit_id: row for unit_id, row in recent.items()
+            if row.get('source_seq', -1) >= minimum_seq
+        }
+
+    def _record_unit_removal(self, packet):
+        """Remove a tracked own unit and preserve its best packet-exact cause."""
+        unit_id = packet.get('unit_id')
+        if unit_id is None or not isinstance(self.player_units, dict):
+            return
+        removed_unit = self.player_units.pop(unit_id, None)
+        if removed_unit is None:
+            logger.debug(
+                f"Received PACKET_UNIT_REMOVE for unit {unit_id} "
+                "(not in our tracked units)")
+            return
+        recent = getattr(self, '_recent_unit_combat', {})
+        combat = recent.pop(unit_id, None) if isinstance(recent, dict) else None
+        cause = combat.get('cause') if combat else 'engine_removed'
+        detail = (
+            "PACKET_UNIT_COMBAT_INFO reported {} HP 0 before "
+            "PACKET_UNIT_REMOVE.".format(
+                'attacker' if cause == 'combat_attacker_lost' else 'defender')
+            if combat else
+            "PACKET_UNIT_REMOVE did not include a root cause.")
+        unit_type = removed_unit.get(
+            'type', self._authoritative_unit_type_name(removed_unit.get('utype')))
+        self._append_unit_lifecycle({
+            'transition': 'disappeared',
+            'unit_id': unit_id,
+            'unit_type': unit_type or 'unknown',
+            'owner': removed_unit.get('owner'),
+            'source_seq': self.source_seq,
+            'turn': self.game_turn,
+            'cause': cause,
+            'detail': detail,
+            'combat': combat,
+        })
+        logger.info(
+            f"✓ Removed unit {unit_id} (type={unit_type}, cause={cause})")
+
