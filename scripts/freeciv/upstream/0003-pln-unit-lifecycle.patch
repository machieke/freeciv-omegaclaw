+def test_combat_and_remove_packets_preserve_exact_unit_loss_cause():
+    civcom = make_civcom()
+    civcom.player_units = {
+        7: {"id": 7, "owner": 0, "type": "Riflemen", "utype": 1},
+    }
+    civcom.unit_lifecycle = []
+    civcom._recent_unit_combat = {}
+    civcom.source_seq = 45
+    CivCom._record_unit_combat(civcom, {
+        "pid": PACKET_UNIT_COMBAT_INFO,
+        "attacker_unit_id": 7, "defender_unit_id": 8,
+        "attacker_hp": 0, "defender_hp": 3,
+    })
+    civcom.source_seq = 46
+    CivCom._record_unit_removal(civcom, {
+        "pid": PACKET_UNIT_REMOVE, "unit_id": 7,
+    })
+
+    assert 7 not in civcom.player_units
+    assert civcom.unit_lifecycle[-1]["cause"] == "combat_attacker_lost"
+    assert civcom.unit_lifecycle[-1]["source_seq"] == 46
+    assert civcom.unit_lifecycle[-1]["combat"]["attacker_hp"] == 0
+    state = CivCom.build_pln_authoritative_state(civcom, 0)
+    assert state["authoritative"]["unit_lifecycle"][-1]["unit_id"] == 7
