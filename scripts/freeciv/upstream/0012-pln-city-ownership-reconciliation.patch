                     self._wonder_cache.pop(f"{owner}_wonders", None)
                     logger.info(f"✓ Stored city {city_id} ({city_data['name']}, size={city_data['size']}) for owner {owner}")
 
+            # Short city info replaces full city info when the player loses
+            # visibility into a city's internals, most importantly after
+            # another player captures it. Treat an owner transition like the
+            # native client does: discard stale production/economy fields and
+            # retain only the public city data carried by this packet.
+            elif packet_type == PACKET_CITY_SHORT_INFO:
+                city_id = packet.get('id')
+                owner = packet.get('owner')
+                if city_id is not None and owner is not None:
+                    if not isinstance(self.player_cities, dict):
+                        self.player_cities = {}
+                    previous = self.player_cities.get(city_id)
+                    previous_owner = (
+                        previous.get('owner')
+                        if isinstance(previous, dict) else None)
+                    tile_idx = packet.get(
+                        'tile',
+                        previous.get('tile') if isinstance(previous, dict) else None)
+                    x, y = None, None
+                    if tile_idx is not None:
+                        xsize = max(1, self.map_info.get('width', 80))
+                        x = tile_idx % xsize
+                        y = tile_idx // xsize
+
+                    public_fields = {
+                        'id': city_id,
+                        'owner': owner,
+                        'name': packet.get(
+                            'name',
+                            previous.get('name', f'City{city_id}')
+                            if isinstance(previous, dict) else f'City{city_id}'),
+                        'tile': tile_idx,
+                        'x': x,
+                        'y': y,
+                        'size': packet.get(
+                            'size',
+                            previous.get('size', 1)
+                            if isinstance(previous, dict) else 1),
+                        'improvements': packet.get('improvements', []),
+                        'short_info': True,
+                        'internals_available': False,
+                    }
+                    if previous_owner is not None and previous_owner != owner:
+                        self.player_cities[city_id] = public_fields
+                        wonder_cache = getattr(self, '_wonder_cache', {})
+                        wonder_cache.pop(f"{previous_owner}_wonders", None)
+                        wonder_cache.pop(f"{owner}_wonders", None)
+                        logger.info(
+                            f"✓ Reconciled city {city_id} ownership "
+                            f"{previous_owner} → {owner}; discarded stale internals")
+                    elif previous is None:
+                        self.player_cities[city_id] = public_fields
+                        logger.info(
+                            f"✓ Stored externally visible city {city_id} "
+                            f"for owner {owner}")
+                    else:
+                        # A same-owner short update must not erase a still
+                        # authoritative full packet, but its public fields are
+                        # newer and safe to merge.
+                        previous.update({
+                            key: value for key, value in public_fields.items()
+                            if key not in ('short_info', 'internals_available')
+                        })
+
             # City removal packet - sent when a city is destroyed or disbanded
