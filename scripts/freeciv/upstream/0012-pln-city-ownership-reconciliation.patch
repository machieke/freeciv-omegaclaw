+def test_city_short_info_reconciles_capture_and_discards_stale_internals():
+    civcom = make_civcom()
+    civcom.source_update_event = asyncio.Event()
+    civcom.source_update_loop = None
+    civcom._action_cache = {"12_0_city_actions": [{"stale": True}]}
+    civcom._wonder_cache = {
+        "0_wonders": ["Pyramids"],
+        "1_wonders": [],
+    }
+    civcom.username = "packet-observer"
+    civcom.player_cities[4].update({
+        "name": "Rome",
+        "tile": 23,
+        "production_kind": 0,
+        "production_value": 1,
+        "can_build": [{"kind": "unit", "value": 1}],
+    })
+
+    CivCom.parse_and_store_packet(civcom, json.dumps({
+        "pid": PACKET_CITY_SHORT_INFO,
+        "id": 4,
+        "owner": 1,
+        "tile": 23,
+        "size": 7,
+        "name": "Captured Rome",
+        "improvements": [1],
+    }))
+
+    city = civcom.player_cities[4]
+    assert city == {
+        "id": 4,
+        "owner": 1,
+        "name": "Captured Rome",
+        "tile": 23,
+        "x": 3,
+        "y": 2,
+        "size": 7,
+        "improvements": [1],
+        "short_info": True,
+        "internals_available": False,
+    }
+    assert CivCom._filter_by_owner(civcom, civcom.player_cities, 0) == {}
+    assert civcom._action_cache == {}
+    assert civcom._wonder_cache == {}
+
+
+def test_same_owner_city_short_info_preserves_full_city_internals():
+    civcom = make_civcom()
+    civcom.source_update_event = asyncio.Event()
+    civcom.source_update_loop = None
+    civcom._action_cache = {}
+    civcom._wonder_cache = {}
+    civcom.username = "packet-observer"
+    civcom.player_cities[4].update({
+        "name": "Rome",
+        "tile": 23,
+        "production_kind": 0,
+        "production_value": 1,
+    })
+
+    CivCom.parse_and_store_packet(civcom, json.dumps({
+        "pid": PACKET_CITY_SHORT_INFO,
+        "id": 4,
+        "owner": 0,
+        "tile": 24,
+        "size": 8,
+        "name": "Roma",
+    }))
+
+    city = civcom.player_cities[4]
+    assert city["name"] == "Roma"
+    assert city["tile"] == 24
+    assert city["x"] == 4
+    assert city["y"] == 2
+    assert city["size"] == 8
+    assert city["production_kind"] == 0
+    assert city["production_value"] == 1
+    assert "short_info" not in city
+    assert "internals_available" not in city
+
