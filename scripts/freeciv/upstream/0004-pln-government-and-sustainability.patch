+        name = packet.get('name') or packet.get('rule_name')
+        if not name:
+            return None
+        return str(name).replace('?government:', '').strip()
+
+    def _government_state(self, player_id):
+        """Project the exact revolution/government state advertised by Freeciv."""
+        player = getattr(self, 'player_packets', {}).get(player_id, {})
+        governments = getattr(self, 'governments', {})
+        current_id = player.get('government')
+        target_id = player.get('target_government')
+        current_name = self._ruleset_name(governments.get(current_id))
+        target_name = self._ruleset_name(governments.get(target_id))
+        revolution_finishes = player.get('revolution_finishes')
+        in_revolution = bool(
+            (current_name and current_name.casefold() == 'anarchy')
+            or (
+                isinstance(revolution_finishes, int)
+                and revolution_finishes >= 0
+            )
+        )
+        selection_required = bool(
+            current_name
+            and current_name.casefold() == 'anarchy'
+            and isinstance(revolution_finishes, int)
+            and revolution_finishes <= getattr(self, 'game_turn', 0)
+        )
+        available = bool(getattr(self, 'rulesets_ready', False) and governments)
+        diagnostic = None
+        if not available:
+            diagnostic = 'Government ruleset packets are not complete'
+        elif current_name is None:
+            diagnostic = 'Current government ID has no ruleset definition'
+        return {
+            'current_id': current_id,
+            'current_name': current_name,
+            'target_id': target_id,
+            'target_name': target_name,
+            'revolution_finishes': revolution_finishes,
+            'in_revolution': in_revolution,
+            'selection_required': selection_required,
+            'available': available,
+            'diagnostic': diagnostic,
+        }
+
+    def _government_requirements_met(self, government, player_id):
+        """Evaluate the packet requirement subset needed by stock governments.
+
+        Government requirements in the supported rulesets are player
+        technology requirements. Unknown requirement kinds fail closed so the
+        proxy never advertises a government that the server may reject.
+        """
+        requirements = government.get('reqs', []) if isinstance(government, dict) else []
+        if not isinstance(requirements, list):
+            return False
+        for requirement in requirements:
+            if not isinstance(requirement, dict):
+                return False
+            kind = requirement.get('kind')
+            value = requirement.get('value')
+            present = requirement.get('present', True)
+            if kind not in (1, '1') or isinstance(value, bool):
+                return False
+            try:
+                tech_id = int(value)
+            except (TypeError, ValueError):
+                return False
+            is_known = self.get_tech_state(tech_id, player_id) == 'KNOWN'
+            if is_known != bool(present):
+                return False
+        return True
+
+    def _get_government_change_actions(self, player_id):
+        """Advertise legal post-revolution government selections."""
+        government_state = self._government_state(player_id)
+        if not (
+            government_state.get('available')
+            and government_state.get('selection_required')
+        ):
+            return []
+        actions = []
+        current_id = government_state.get('current_id')
+        for government_id, government in sorted(
+            getattr(self, 'governments', {}).items()
+        ):
+            name = self._ruleset_name(government)
+            if (
+                government_id == current_id
+                or not name
+                or name.casefold() == 'anarchy'
+                or not self._government_requirements_met(government, player_id)
+            ):
+                continue
+            actions.append({
+                'type': 'government_change',
+                'player_id': player_id,
+                'government_id': government_id,
+                'government_name': name,
+                'target': {
+                    'government_id': government_id,
+                    'government_name': name,
+                },
+                'reason': 'government_selection_required',
+                'is_valid': True,
+            })
+        return actions
     
