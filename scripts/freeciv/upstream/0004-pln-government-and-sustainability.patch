+    civcom.unit_lifecycle = []
+    civcom._recent_unit_combat = {}
+    civcom.source_seq = 50
+    CivCom._record_unit_combat(civcom, {
+        "attacker_unit_id": 8,
+        "defender_unit_id": 7,
+        "attacker_hp": 5,
+        "defender_hp": 0,
+    })
+    civcom.source_seq = 51
+    CivCom._record_unit_removal(civcom, {"unit_id": 7})
+    civcom.source_seq = 52
+    CivCom._record_unit_removal(civcom, {"unit_id": 9})
+
+    assert civcom.unit_lifecycle[-1]["cause"] == "combat_stack_collateral"
+    assert civcom.unit_lifecycle[-1]["evidence_quality"] == "inferred"
