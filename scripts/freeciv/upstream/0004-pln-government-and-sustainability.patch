+        government_name = str(action.get('government_name', '')).strip()
+        if not government_name:
+            return self._validation_error(
+                'E043', 'Government change requires government_name field')
+        if len(government_name) > MAX_NAME_LENGTH:
+            return self._validation_error('E043', 'government_name is too long')
+        import re
+        if not re.match(r"^[\w\s\.\-']+$", government_name, flags=re.UNICODE):
+            return self._validation_error(
+                'E043', 'government_name contains invalid characters')
+
+        return ValidationResult(True)
