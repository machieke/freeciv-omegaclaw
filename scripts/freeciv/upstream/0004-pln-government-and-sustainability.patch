+class TestGovernmentActionConverters:
+    def test_government_change_uses_exact_ruleset_id_and_name(self):
+        class CivCom:
+            governments = {
+                1: {"id": 1, "name": "Despotism", "rule_name": "Despotism"},
+            }
+
+        result = _convert_action_to_packet({
+            "type": "government_change",
+            "government_id": 1,
+            "government_name": "Despotism",
+        }, CivCom())
+
+        assert result == {
+            "pid": PACKET_PLAYER_CHANGE_GOVERNMENT,
+            "government": 1,
+        }
+
+    def test_government_change_rejects_mismatched_name(self):
+        class CivCom:
+            governments = {
+                1: {"id": 1, "name": "Despotism", "rule_name": "Despotism"},
+            }
+
+        with pytest.raises(ValueError, match="does not match"):
+            _convert_action_to_packet({
+                "type": "government_change",
+                "government_id": 1,
+                "government_name": "Monarchy",
+            }, CivCom())
+
