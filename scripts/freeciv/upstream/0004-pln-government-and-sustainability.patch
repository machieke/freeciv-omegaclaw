+    @staticmethod
+    def _notification_cause(message):
+        """Map exact server notification text to a removal cause."""
+        text = str(message or '').casefold()
+        if 'not enough gold.' in text and 'disbanded' in text:
+            return 'upkeep_gold'
+        if 'famine feared in' in text and 'lost' in text:
+            return 'upkeep_food'
+        if 'lost when' in text and 'was lost' in text:
+            return 'transport_lost'
+        return None
+
+    def _notification_matches_lifecycle(self, notification, row):
+        if row.get('transition') != 'disappeared':
+            return False
+        if row.get('turn') != notification.get('turn'):
+            return False
+        source_seq = row.get('source_seq')
+        notification_seq = notification.get('source_seq')
+        if (
+            not isinstance(source_seq, int)
+            or not isinstance(notification_seq, int)
+            or abs(notification_seq - source_seq) > 128
+        ):
+            return False
+        tile = notification.get('tile')
+        if tile is not None and row.get('tile') == tile:
+            return True
+        unit_type = str(row.get('unit_type') or '').casefold()
+        return bool(unit_type and unit_type in notification.get('message', '').casefold())
+
+    def _attribute_lifecycle_notification(self, notification):
+        """Apply a nearby exact server notification to its unit removal."""
+        for row in reversed(getattr(self, 'unit_lifecycle', [])):
+            if (
+                row.get('cause') in (
+                    'engine_removed', 'combat_stack_collateral', 'transport_lost')
+                and self._notification_matches_lifecycle(notification, row)
+            ):
+                row['cause'] = notification['cause']
+                row['detail'] = (
+                    'Freeciv server notification: '
+                    + notification.get('message', ''))
+                row['evidence_quality'] = 'exact'
+                row['notification'] = dict(notification)
+                return True
+        return False
+
+    def _record_engine_notification(self, packet):
+        """Correlate removal notifications emitted before or after UNIT_REMOVE."""
+        cause = self._notification_cause(packet.get('message'))
+        if not cause:
+            return
+        notification = {
+            'cause': cause,
+            'message': str(packet.get('message') or ''),
+            'tile': packet.get('tile'),
+            'event': packet.get('event'),
+            'turn': packet.get('turn', self.game_turn),
+            'source_seq': self.source_seq,
+        }
+        if self._attribute_lifecycle_notification(notification):
+            return
+        pending = getattr(self, '_pending_unit_notifications', [])
+        if not isinstance(pending, list):
+            pending = []
+        pending.append(notification)
+        self._pending_unit_notifications = [
+            row for row in pending
+            if row.get('source_seq', -1) >= self.source_seq - 256
+        ][-64:]
