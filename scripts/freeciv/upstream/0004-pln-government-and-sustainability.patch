+def test_finished_revolution_advertises_only_known_legal_governments():
+    civcom = make_civcom()
+    civcom.player_packets[0].update({
+        "government": 0,
+        "target_government": 0,
+        "revolution_finishes": 12,
+    })
+    civcom.research_info[0]["inventions"] = [2, 1]
+
+    state = CivCom._government_state(civcom, 0)
+    actions = CivCom._get_government_change_actions(civcom, 0)
+
+    assert state["current_name"] == "Anarchy"
+    assert state["selection_required"] is True
+    assert [(row["government_id"], row["government_name"]) for row in actions] == [
+        (1, "Despotism"),
+    ]
+
+
+def test_removal_notification_attributes_gold_and_food_losses_exactly():
+    civcom = make_civcom()
+    civcom.player_units = {
+        9: {
+            "id": 9, "owner": 0, "type": "Settlers", "utype": 1,
+            "tile": 44, "homecity": 4,
+        },
+    }
+    civcom.unit_lifecycle = []
+    civcom._recent_unit_combat = {}
+    civcom.source_seq = 50
+    CivCom._record_unit_removal(
+        civcom, {"pid": PACKET_UNIT_REMOVE, "unit_id": 9})
+    civcom.source_seq = 51
+    CivCom._record_engine_notification(civcom, {
+        "message": "Not enough gold. Settlers disbanded.",
+        "tile": 44,
+        "turn": 12,
+        "event": 9,
+    })
+
+    row = civcom.unit_lifecycle[-1]
+    assert row["cause"] == "upkeep_gold"
+    assert row["evidence_quality"] == "exact"
+    assert "Not enough gold" in row["detail"]
+
+
+def test_same_tile_combat_removal_is_marked_as_inferred_collateral():
+    civcom = make_civcom()
+    civcom.player_units = {
+        7: {"id": 7, "owner": 0, "type": "Warriors", "tile": 44},
+        9: {"id": 9, "owner": 0, "type": "Settlers", "tile": 44},
