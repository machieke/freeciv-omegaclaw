+def test_stable_government_completion_marker_is_not_active_revolution():
+    civcom = make_civcom()
+    civcom.game_turn = 12
+    civcom.player_packets[0].update({
+        "government": 1,
+        "target_government": 1,
+        "revolution_finishes": 12,
+    })
+    civcom.research_info[0]["inventions"] = [2, 2]
+
+    state = CivCom._government_state(civcom, 0)
+    actions = CivCom._get_government_change_actions(civcom, 0)
+
+    assert state["current_name"] == "Despotism"
+    assert state["in_revolution"] is False
+    assert state["selection_required"] is False
+    assert actions[0]["reason"] == "government_transition_available"
+
