+    def _get_player_rate_actions(self, player_id):
+        """Advertise bounded, packet-exact treasury/science rate controls.
+
+        Every stock government permits rates up to 60 percent. Keeping this
+        recovery surface within that shared bound avoids guessing government
+        effects while still allowing the agent to trade one ten-point science
+        increment for tax and restore the configured 40/60 split later.
+        """
+        player = getattr(self, 'player_packets', {}).get(player_id, {})
+        government_state = self._government_state(player_id)
+        if (
+            not isinstance(player, dict)
+            or government_state.get('selection_required')
+            or str(government_state.get('current_name', '')).casefold()
+                == 'anarchy'
+        ):
+            return []
+        tax = player.get('tax')
+        luxury = player.get('luxury')
+        science = player.get('science')
+        if (
+            any(isinstance(value, bool) or not isinstance(value, int)
+                for value in (tax, luxury, science))
+            or tax + luxury + science != 100
+        ):
+            return []
+
+        actions = []
+
+        def add(target_tax, target_science, reason):
+            target = {
+                'tax_rate': target_tax,
+                'luxury_rate': luxury,
+                'science_rate': target_science,
+            }
+            actions.append({
+                'type': 'player_rates',
+                'player_id': player_id,
+                'target': target,
+                'reason': reason,
+                'is_valid': True,
+            })
+
+        if tax < 60 and science >= 10:
+            add(tax + 10, science - 10, 'bounded_treasury_recovery')
+        if tax > 40 and science < 60:
+            increment = min(10, tax - 40, 60 - science)
+            if increment > 0:
+                add(tax - increment, science + increment,
+                    'bounded_science_restoration')
+        return actions
     
