+            "schema_version": "1.0",
+            "authority": "freeciv-server-pathfinder",
+            "unit_id": 7,
+            "origin_tile": 10,
+            "destination_tile": 44,
+            "reachable": False,
+            "first_step_tile": -1,
+            "first_step_movement_cost": -1,
+            "path_length": 0,
+            "estimated_turns": -1,
+            "total_movement_cost": -1,
+            "movement_points_remaining": 0,
+            "moves_left_at_request": 3,
+            "transported_at_request": False,
+            "initially_transported": False,
+            "turn": 12,
+            "source_seq": 44,
+        },
+    }
+    civcom.pln_movement_route_event = asyncio.Event()
+    queued = []
