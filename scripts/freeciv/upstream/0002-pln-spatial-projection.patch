+def test_authoritative_state_projects_only_packet_known_spatial_evidence():
+    civcom = make_civcom()
+    civcom.map_info["wrap_x"] = True
+    civcom.tiles = {
+        12: {"terrain": 4, "known": 2, "owner": 0, "extras": [3]},
+        "13": {"terrain": 5, "known": 1, "resource": 7},
+        14: {"terrain": 6, "known": 0},
+        100: {"terrain": 7, "known": 2},
+        "bad": {"terrain": 8, "known": 2},
+    }
+
+    state = CivCom.build_pln_authoritative_state(civcom, 0)
+
+    assert state["map"] == {
+        "width": 10,
+        "height": 10,
+        "wrap_x": True,
+        "tiles": [
+            {"index": 12, "x": 2, "y": 1, "terrain": 4, "known": 2,
+             "owner": 0, "extras": [3]},
+            {"index": 13, "x": 3, "y": 1, "terrain": 5, "known": 1,
+             "resource": 7},
+        ],
+        "visibility": {"12": True},
+    }
+    assert state["visible_tiles"] == [12]
+
+
