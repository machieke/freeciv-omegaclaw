+def test_authoritative_spatial_projection_adds_public_terrain_semantics():
+    civcom = make_civcom()
+    civcom.map_info = {
+        "width": 10,
+        "height": 10,
+        "topology_id": 1,
+        "wrap_x": True,
+        "wrap_y": False,
+    }
+    civcom.tiles = {
+        12: {
+            "terrain": 5,
+            "known": 2,
+        },
+        13: {
+            "terrain": 99,
+            "known": 1,
+        },
+    }
+    civcom.terrains = {
+        5: {
+            "name": "Ocean",
+            "native_to": [
+                0,
+                1 << 1,
+            ],
+            "tclass": 1,
+        },
+    }
+    civcom.unit_classes = {
+        1: {
+            "name": "?unitclass:Land",
+        },
+        9: {
+            "name": "?unitclass:Sea",
+        },
+    }
+
+    projected, visible = (
+        CivCom._build_pln_spatial_projection(
+            civcom))
+
+    assert projected[
+        "topology_id"] == 1
+    assert visible == [12]
+    assert projected["tiles"] == [{
+        "index": 12,
+        "x": 2,
+        "y": 1,
+        "terrain": 5,
+        "known": 2,
+        "terrain_name": "Ocean",
+        "terrain_class": "ocean",
+        "native_unit_classes": [
+            "Sea",
+        ],
+    }, {
+        "index": 13,
+        "x": 3,
+        "y": 1,
+        "terrain": 99,
+        "known": 1,
+    }]
+
+
