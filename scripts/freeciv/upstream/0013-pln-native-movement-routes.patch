+    def _current_pln_movement_routes(self, player_id):
+        """Project only routes that still match current packet state."""
+        units = self._normalize_to_dict(getattr(self, 'player_units', {}))
+        result = []
+        for route in getattr(self, 'pln_movement_routes', {}).values():
+            unit_id = route.get('unit_id') if isinstance(route, dict) else None
+            unit = units.get(str(unit_id))
+            if unit is None:
+                unit = units.get(unit_id)
+            if (
+                isinstance(unit, dict)
+                and unit.get('owner') == player_id
+                and self._valid_pln_movement_route(
+                    route, unit, route.get('destination_tile'))
+            ):
+                result.append(dict(route))
+        return sorted(
+            result,
+            key=lambda route: (
+                route['unit_id'], route['destination_tile']))
