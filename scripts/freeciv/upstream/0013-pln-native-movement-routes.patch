+        if unit is None:
+            unit = getattr(self, 'player_units', {}).get(unit_id)
+        if not isinstance(unit, dict):
+            return
+        reachable = packet.get('reachable')
+        initially_transported = packet.get('initially_transported')
+        if (
+            not isinstance(reachable, bool)
+            or not isinstance(initially_transported, bool)
+        ):
+            return
+        directions = packet.get('dir', [])
+        if not isinstance(directions, list):
+            directions = []
+        length = packet.get('length')
+        first_step = packet.get('first_step')
+        first_step_mc = packet.get('first_step_mc')
+        turns = packet.get('turns')
+        total_mc = packet.get('total_mc')
+        moves_left = packet.get('moves_left')
+        numeric = (
+            length, first_step, first_step_mc, turns, total_mc, moves_left)
+        if any(
+            isinstance(value, bool) or not isinstance(value, int) or value < 0
+            for value in numeric
+        ):
+            return
+        if len(directions) != length:
+            return
+        route = {
+            'schema_version': '1.0',
+            'authority': 'freeciv-server-pathfinder',
+            'unit_id': unit_id,
+            'origin_tile': unit.get('tile'),
+            'destination_tile': destination_tile,
+            'reachable': reachable,
+            'first_step_tile': first_step,
+            'first_step_movement_cost': first_step_mc,
+            'path_length': length,
+            'path_directions': list(directions),
+            'estimated_turns': turns,
+            'total_movement_cost': total_mc,
+            'movement_points_remaining': moves_left,
+            'moves_left_at_request': unit.get('moves_left'),
+            'transported_at_request': unit.get('transported'),
+            'initially_transported': initially_transported,
+            'turn': self.game_turn,
+            'source_seq': self.source_seq,
+        }
+        key = self._pln_movement_route_key(unit_id, destination_tile)
+        routes = getattr(self, 'pln_movement_routes', None)
+        if not isinstance(routes, dict):
+            routes = {}
+            self.pln_movement_routes = routes
+        routes[key] = route
+        if len(routes) > 512:
+            oldest = min(
+                routes, key=lambda route_key: (
+                    routes[route_key].get('source_seq', -1), route_key))
+            del routes[oldest]
