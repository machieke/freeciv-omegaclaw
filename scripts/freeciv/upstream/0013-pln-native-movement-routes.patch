+    def _valid_pln_movement_route(self, route, unit, destination_tile):
+        """Require an exact current unit revision before exposing a route."""
+        return (
+            isinstance(route, dict)
+            and isinstance(unit, dict)
+            and route.get('unit_id') == unit.get('id')
+            and route.get('origin_tile') == unit.get('tile')
+            and route.get('destination_tile') == destination_tile
+            and route.get('turn') == self.game_turn
+            and route.get('moves_left_at_request') == unit.get('moves_left')
+            and route.get('transported_at_request') == unit.get('transported')
+        )
+
+    def _record_pln_movement_route(self, packet):
+        """Store one player-scoped native path response without inference."""
+        unit_id = packet.get('unit_id')
+        destination_tile = packet.get('dest')
+        if (
+            isinstance(unit_id, bool) or not isinstance(unit_id, int)
+            or isinstance(destination_tile, bool)
+            or not isinstance(destination_tile, int)
+        ):
+            return
+        unit = self._normalize_to_dict(
