+    async def prepare_pln_movement_routes(
+            self, player_id, maximum_routes=64, timeout_seconds=0.25):
+        """Request bounded native unit-to-own-city paths and await responses."""
+        if (
+            isinstance(maximum_routes, bool)
+            or not isinstance(maximum_routes, int)
+            or maximum_routes < 1 or maximum_routes > 64
+        ):
+            raise ValueError("maximum_routes must be in 1..64")
+        units = [
+            unit for unit in self._normalize_to_dict(
+                getattr(self, 'player_units', {})).values()
+            if (
+                unit.get('owner') == player_id
+                and isinstance(unit.get('id'), int)
+                and isinstance(unit.get('tile'), int)
+                and isinstance(unit.get('moves_left'), int)
+                and unit.get('moves_left') > 0
+            )
+        ]
+        destinations = sorted({
+            city.get('tile')
+            for city in self._normalize_to_dict(
+                getattr(self, 'player_cities', {})).values()
+            if (
+                city.get('owner') == player_id
+                and isinstance(city.get('tile'), int)
+            )
+        })
+        requests = []
+        routes = getattr(self, 'pln_movement_routes', {})
+        for unit in sorted(units, key=lambda row: row['id']):
+            for destination_tile in destinations:
+                if unit['tile'] == destination_tile:
+                    continue
+                key = self._pln_movement_route_key(
+                    unit['id'], destination_tile)
+                if self._valid_pln_movement_route(
+                        routes.get(key), unit, destination_tile):
+                    continue
+                requests.append((key, unit['id'], destination_tile))
+                if len(requests) >= maximum_routes:
+                    break
+            if len(requests) >= maximum_routes:
+                break
+        if not requests:
+            return 0
+
+        event = getattr(self, 'pln_movement_route_event', None)
+        if event is None:
+            event = asyncio.Event()
+            self.pln_movement_route_event = event
+        self.source_update_loop = asyncio.get_running_loop()
+        event.clear()
+        for _, unit_id, destination_tile in requests:
+            self.queue_to_civserver(json.dumps({
+                'pid': PACKET_WEB_GOTO_PATH_REQ,
+                'unit_id': unit_id,
+                'goal': destination_tile,
+            }))
+        self.send_packets_to_civserver()
+
+        loop = asyncio.get_running_loop()
+        deadline = loop.time() + timeout_seconds
+        pending = {key for key, _, _ in requests}
+        while pending:
+            pending = {
+                key for key in pending
+                if key not in getattr(self, 'pln_movement_routes', {})
+            }
+            if not pending:
+                break
+            remaining = deadline - loop.time()
+            if remaining <= 0:
+                break
+            event.clear()
+            # Close the response/cache race around Event.clear().
+            pending = {
+                key for key in pending
+                if key not in getattr(self, 'pln_movement_routes', {})
+            }
+            if not pending:
+                break
+            try:
+                await asyncio.wait_for(event.wait(), timeout=remaining)
+            except asyncio.TimeoutError:
+                break
+        return len(requests) - len(pending)
+
+    def _pln_first_step_context(self, player_id, unit_id, target_tile):
+        """Return an exact native edge cost only when all matching paths agree."""
+        matching_routes = [
+            route for route in self._current_pln_movement_routes(player_id)
+            if (
+                route.get('unit_id') == int(unit_id)
+                and route.get('reachable') is True
+                and route.get('first_step_tile') == target_tile
+                and route.get('initially_transported') is False
+            )
+        ]
+        costs = {
+            route.get('first_step_movement_cost')
+            for route in matching_routes
+            if (
+                isinstance(route.get('first_step_movement_cost'), int)
+                and not isinstance(
+                    route.get('first_step_movement_cost'), bool)
+                and route.get('first_step_movement_cost') > 0
+            )
+        }
+        if len(costs) != 1:
+            return None
+        return {
+            'movement_cost': costs.pop(),
+            'transport_required': False,
+        }
